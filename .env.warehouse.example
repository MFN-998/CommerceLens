# Copy to ignored .env.warehouse in the repository root. Never commit actual credentials.
# Environment variables take precedence. M2 administration permits development/test only.
WAREHOUSE_ENVIRONMENT=development
WAREHOUSE_PROJECT_REF=abcdefghijklmnopqrst
WAREHOUSE_HOST=db.abcdefghijklmnopqrst.supabase.co
WAREHOUSE_PORT=5432
WAREHOUSE_DATABASE=postgres
WAREHOUSE_USER=postgres
WAREHOUSE_PASSWORD='REPLACE_ME'
# Download this public CA from your project's Database > Settings > SSL certificate link.
WAREHOUSE_SSLROOTCERT=.credentials/supabase-ca.crt
# If direct IPv6 is unavailable, copy the real session pooler host from Connect.
# Keep port 5432 and use postgres.<project-ref> as WAREHOUSE_USER. Never use weaker TLS.
